# ──────────────────────────────────────────────
# Hands-Free Assistant — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Rime TTS ─────────────────────────────────
# Get your key at https://rime.ai
RIME_API_KEY=your_rime_api_key_here

# ── Qdrant Cloud ─────────────────────────────
# Get from your Qdrant Cloud cluster dashboard
# Format: https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=hands-free-procedures

# ── Anthropic Claude ─────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Hugging Face (free embeddings) ──────────
# Model: sentence-transformers/all-MiniLM-L6-v2 (384 dims, free)
# Get a Read token at https://huggingface.co/settings/tokens
HF_API_TOKEN=your_hf_read_token_here

# ── Server ───────────────────────────────────
PORT=3001
